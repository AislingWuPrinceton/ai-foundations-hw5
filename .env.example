# Copy to .env in this folder and fill in your own key. Never commit .env.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional settings (defaults shown in comments):
# CAMPUS_CUSTOMS_DB=data/campus_customs_new.db          # working database the MCP server uses
# CAMPUS_CUSTOMS_ORIGINAL_DB=data/campus_customs.db     # source for the reset route
# CAMPUS_CUSTOMS_AUDIT=output/audit_trail.json          # audit trail file
# CAMPUS_CUSTOMS_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CAMPUS_CUSTOMS_RUN_LABEL=my-fresh-run                 # label stamped on every audit entry
